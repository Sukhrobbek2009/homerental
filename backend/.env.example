# Copy this file to .env and fill in real values before running in production.

# Random long random string used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-secret

# SQLite by default (fine for dev). For production point this at Postgres, e.g.
#   postgresql+psycopg2://user:password@localhost:5432/uzbek_rentals
DATABASE_URL=sqlite:///./app.db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of origins allowed to call this API from the browser.
# The app now serves the frontend pages itself on port 8000, so that origin is
# same-origin already and doesn't strictly need to be here — these matter only
# if you serve the HTML separately (e.g. Jekyll on :4000) from the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4000,http://127.0.0.1:4000

# Optional: enables the "Continue with Google" button on /login and /signup.
# Leave blank and the button stays disabled — nothing else breaks.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID, type "Web application"
# 3. Under "Authorized JavaScript origins" add the exact origin(s) you serve
#    this site from, e.g. http://localhost:8000 and your production domain
#    (no path, no trailing slash — Google Identity Services checks this)
# 4. Paste the client ID below. No code changes needed.
GOOGLE_CLIENT_ID=
