# Copy this file to .env and fill in real values before running in production.

# Required. Private random string (32+ characters) used to sign login tokens;
# the server won't start without one. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# SQLite by default (fine for dev). On Railway, add a Postgres plugin and it
# injects this automatically, e.g.
#   postgresql://user:password@host:5432/railway
# (a legacy "postgres://" URL is normalized to "postgresql://" automatically).
DATABASE_URL=sqlite:///./app.db

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of origins allowed to call this API from the browser.
# The app now serves the frontend pages itself on port 8000, so that origin is
# same-origin already and doesn't strictly need to be here — these matter only
# if you serve the HTML separately (e.g. Jekyll on :4000) from the API.
# Exact origins only (scheme://host[:port], no path): "*" is refused at startup.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4000,http://127.0.0.1:4000

# Login and signup attempts allowed per client IP per minute (0 = no limit).
AUTH_RATE_LIMIT_PER_MINUTE=5
# Number of reverse proxies in front of the app that append to
# X-Forwarded-For. Leave 0 locally. On Railway set 1, then check the "ip=" in
# the request log shows real visitor addresses rather than Railway's own; if
# it stays 0 there, every visitor shares one rate limit.
TRUSTED_PROXY_COUNT=0

# Optional: enables the "Continue with Google" button on /login and /signup.
# Leave blank and the button stays disabled — nothing else breaks.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID, type "Web application"
# 3. Under "Authorized JavaScript origins" add the exact origin(s) you serve
#    this site from, e.g. http://localhost:8000 and your production domain
#    (no path, no trailing slash — Google Identity Services checks this)
# 4. Paste the client ID below. No code changes needed.
GOOGLE_CLIENT_ID=

# Password for the seeded demo admin account (admin@uzbekrentals.app).
# Leave blank in dev and a random one is generated and printed to the log on
# first startup. Set this explicitly for any shared/production deployment.
DEMO_ADMIN_PASSWORD=

# Shared password for every seeded starter host/renter account (see
# backend/app/seed.py) — e.g. host-aziza@uzbekrentals.app,
# renter-dilnoza@uzbekrentals.app. Same behavior as DEMO_ADMIN_PASSWORD
# above: leave blank in dev for a random one printed to the log.
DEMO_USER_PASSWORD=

# Seeds/reseeds demo hosts, renters, listings, reviews, and the demo admin on
# every startup, printing generated passwords to the log. Set to true only for
# local dev; never on a real deployment (e.g. Railway).
SEED_DEMO_DATA=false

# S3-compatible bucket for listing photos (AWS S3, Cloudflare R2, MinIO, ...).
# Leave blank and photo uploads return 503 — nothing else breaks. The bucket
# must allow public reads, since listings link straight to the photo URLs.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Optional: signing region (default us-east-1, which most providers accept).
S3_REGION=
# Optional: public base URL for photos when it isn't <S3_ENDPOINT>/<S3_BUCKET>,
# e.g. an R2 public bucket URL (https://pub-xxxx.r2.dev) or a CDN domain.
S3_PUBLIC_URL=
